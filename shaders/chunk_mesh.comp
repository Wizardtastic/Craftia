#version 450
// Phase 2 — GPU greedy chunk meshing.
//
// One workgroup per (chunk, pass, LOD). Each invocation owns one
// (face, slice) pair, builds a 16x16 exposure/ID mask for that slice, greedily
// merges equal-ID rectangles, and atomically appends packed quads. This is the
// same bitmask strategy as the CPU mesher, so distant chunks stop paying
// one-quad-per-face while keeping the output format identical.
//
// Input:  18³ R16_UINT 3D texture (16³ chunk + 1-voxel border from neighbours).
// Output: packed 16-byte vertices (4 uints), uint indices relative to the
//         chunk's vertex base, and a counter [vertex_count, index_count].
//
// Block flags: bit0 opaque, bit1 liquid, bit2 render, bit3 cutout, bit4 blend.
// Pass 0 emits opaque + alpha-cutout cubes; pass 1 emits only blended cubes.

#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 96) in;

layout(set = 0, binding = 0) uniform usampler3D voxels;

layout(std430, set = 0, binding = 1) readonly buffer PropsBuf {
    uvec4 props[];
};

layout(std430, set = 0, binding = 2) buffer VertBuf { uint verts[]; };
layout(std430, set = 0, binding = 3) buffer IdxBuf { uint idxs[]; };
layout(std430, set = 0, binding = 4) buffer CtrBuf { uint ctr[2]; };

layout(push_constant) uniform PC {
    uint pass_mode; // 0 = opaque/cutout, 1 = blended
    uint lod;       // 0 = 16³, 1 = 8³ (2x), 2 = 4³ (4x)
} pc;

const uint FLAG_OPAQUE = 1u;
const uint FLAG_RENDER = 4u;
const uint FLAG_CUTOUT = 8u;
const uint FLAG_BLEND = 16u;
const float VERTEX_SCALE = 256.0;

uint block_tile(uint id, uint fi) {
    uvec4 p = props[id];
    uint packed = (fi < 2u) ? p.x : (fi < 4u) ? p.y : p.z;
    return (packed >> ((fi & 1u) * 16u)) & 0xFFFFu;
}

// Mask cell (u,v) on a given face/slice -> chunk-local cell coordinates.
ivec3 mask_cell(uint fi, int slice, int u, int v) {
    if (fi < 2u) return ivec3(slice, v, u);       // X faces
    if (fi < 4u) return ivec3(u, slice, v);       // Y faces
    return ivec3(u, v, slice);                    // Z faces
}

// Merged quad corners. Order matches the CPU mesher's `merged_positions`.
vec3 quad_pos(uint fi, float u0, float v0, float w, float h, float slice,
              int corner, float cell) {
    float x, y, z;
    if (fi == 0u) { // NegX
        x = slice; y = v0; z = u0 + w;
        if (corner == 1) y += h;
        if (corner == 2) { y += h; z -= w; }
        if (corner == 3) z -= w;
    } else if (fi == 1u) { // PosX
        x = slice + 1.0; y = v0; z = u0;
        if (corner == 1) y += h;
        if (corner == 2) { y += h; z += w; }
        if (corner == 3) z += w;
    } else if (fi == 2u) { // NegY
        x = u0; y = slice; z = v0;
        if (corner == 1) x += w;
        if (corner == 2) { x += w; z += h; }
        if (corner == 3) z += h;
    } else if (fi == 3u) { // PosY
        x = u0; y = slice + 1.0; z = v0;
        if (corner == 1) z += h;
        if (corner == 2) { x += w; z += h; }
        if (corner == 3) x += w;
    } else if (fi == 4u) { // NegZ
        x = u0; y = v0; z = slice;
        if (corner == 1) y += h;
        if (corner == 2) { x += w; y += h; }
        if (corner == 3) x += w;
    } else { // PosZ
        x = u0 + w; y = v0; z = slice + 1.0;
        if (corner == 1) y += h;
        if (corner == 2) { x -= w; y += h; }
        if (corner == 3) x -= w;
    }
    return vec3(x, y, z) * cell;
}

// UVs match `merged_uvs` on the CPU (local tile repeat, side-face V inverted).
vec2 quad_uv(uint fi, float w, float h, int corner) {
    if (fi == 0u) { // NegX
        if (corner == 0) return vec2(w, h);
        if (corner == 1) return vec2(w, 0.0);
        if (corner == 2) return vec2(0.0, 0.0);
        return vec2(0.0, h);
    } else if (fi == 1u) { // PosX
        if (corner == 0) return vec2(0.0, h);
        if (corner == 1) return vec2(0.0, 0.0);
        if (corner == 2) return vec2(w, 0.0);
        return vec2(w, h);
    } else if (fi == 2u) { // NegY
        if (corner == 0) return vec2(0.0, 0.0);
        if (corner == 1) return vec2(w, 0.0);
        if (corner == 2) return vec2(w, h);
        return vec2(0.0, h);
    } else if (fi == 3u) { // PosY
        if (corner == 0) return vec2(0.0, 0.0);
        if (corner == 1) return vec2(0.0, h);
        if (corner == 2) return vec2(w, h);
        return vec2(w, 0.0);
    } else if (fi == 4u) { // NegZ
        if (corner == 0) return vec2(0.0, h);
        if (corner == 1) return vec2(0.0, 0.0);
        if (corner == 2) return vec2(w, 0.0);
        return vec2(w, h);
    }
    // PosZ
    if (corner == 0) return vec2(w, h);
    if (corner == 1) return vec2(w, 0.0);
    if (corner == 2) return vec2(0.0, 0.0);
    return vec2(0.0, h);
}

void emit_quad(uint fi, uint id, int u0, int v0, int w, int h, int slice,
               float cell) {
    uint v_base = atomicAdd(ctr[0], 4u);
    uint i_base = atomicAdd(ctr[1], 6u);
    uint vo = v_base * 4u;
    uint tile = block_tile(id, fi);
    for (int c = 0; c < 4; c++) {
        vec3 p = quad_pos(fi, float(u0), float(v0), float(w), float(h),
                          float(slice), c, cell);
        vec2 uv = quad_uv(fi, float(w) * cell, float(h) * cell, c);
        uvec3 pq = uvec3(round(p * VERTEX_SCALE));
        uvec2 uq = uvec2(round(uv * VERTEX_SCALE));
        uint o = vo + uint(c) * 4u;
        verts[o + 0] = pq.x | (pq.y << 16);
        verts[o + 1] = pq.z | (uq.x << 16);
        verts[o + 2] = uq.y | ((tile & 0xFFFFu) << 16);
        verts[o + 3] = 0u; // packed water (GPU path only meshes dry chunks)
    }
    idxs[i_base + 0] = v_base;
    idxs[i_base + 1] = v_base + 1u;
    idxs[i_base + 2] = v_base + 2u;
    idxs[i_base + 3] = v_base;
    idxs[i_base + 4] = v_base + 2u;
    idxs[i_base + 5] = v_base + 3u;
}

void main() {
    uint cell = 1u << pc.lod;
    uint grid = 16u >> pc.lod;
    uint total_slices = 6u * grid;
    uint tid = gl_LocalInvocationIndex;
    if (tid >= total_slices) return;

    uint fi = tid / grid;
    int slice = int(tid % grid);

    // Exposure mask for this slice. 16x16 is the largest LOD grid.
    uint rows[16];
    uint ids[256];
    for (int v = 0; v < int(grid); v++) {
        rows[v] = 0u;
        for (int u = 0; u < int(grid); u++) {
            ivec3 c = mask_cell(fi, slice, u, v);
            ivec3 sp = c * int(cell) + ivec3(1);
            uint id = texelFetch(voxels, sp, 0).r;
            uint flags = props[id].w;
            if ((flags & FLAG_RENDER) == 0u) continue;
            bool own = (pc.pass_mode == 0u)
                ? ((flags & (FLAG_OPAQUE | FLAG_CUTOUT)) != 0u)
                : ((flags & FLAG_BLEND) != 0u);
            if (!own) continue;
            ivec3 ncell = c + ivec3(
                fi == 0u ? -1 : fi == 1u ? 1 : 0,
                fi == 2u ? -1 : fi == 3u ? 1 : 0,
                fi == 4u ? -1 : fi == 5u ? 1 : 0);
            ivec3 np = ncell * int(cell) + ivec3(1);
            uint nid = texelFetch(voxels, np, 0).r;
            uint nflags = props[nid].w;
            bool visible = (pc.pass_mode == 0u)
                ? ((nflags & FLAG_OPAQUE) == 0u)
                : ((nflags & FLAG_RENDER) == 0u);
            if (!visible) continue;
            rows[v] |= 1u << u;
            ids[v * 16 + u] = id;
        }
    }

    // Greedy rectangle merge. Consumed bits are cleared, so no visited array.
    for (int v = 0; v < int(grid); v++) {
        uint row = rows[v];
        while (row != 0u) {
            int u = findLSB(row);
            uint id = ids[v * 16 + u];
            int w = 1;
            while (u + w < int(grid)) {
                uint bit = 1u << (u + w);
                if ((row & bit) == 0u || ids[v * 16 + u + w] != id) break;
                w++;
            }
            uint col = ((w >= 32) ? 0xFFFFFFFFu : ((1u << w) - 1u)) << u;
            int h = 1;
            bool grow = true;
            while (v + h < int(grid) && grow) {
                if ((rows[v + h] & col) != col) break;
                for (int i = u; i < u + w; i++) {
                    if (ids[(v + h) * 16 + i] != id) { grow = false; break; }
                }
                if (grow) h++;
            }
            for (int r = v; r < v + h; r++) rows[r] &= ~col;
            emit_quad(fi, id, u, v, w, h, slice, float(cell));
            row = rows[v];
        }
    }
}
