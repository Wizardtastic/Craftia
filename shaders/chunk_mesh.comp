#version 450
// Phase 2 — GPU naive chunk meshing.
//
// One thread per voxel in a 16³ chunk. For each of 6 faces, checks if the face
// is visible against the neighbor voxel and atomically emits a quad (4 vertices
// + 6 indices) into the output buffers. No greedy merging — each visible face
// becomes one quad. Used for distant chunks where triangle quality matters less
// than initial load speed; the CPU greedy mesher refines near chunks.
//
// Input:  18³ R16_UINT 3D texture (16³ chunk + 1-voxel border from neighbours).
// Output: flat uint vertex buffer (8 uints = 32 bytes per vertex, matching the
//         #[repr(C)] Vertex layout), uint index buffer, and a 2-element counter
//         [vertex_count, index_count] incremented atomically.

#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) uniform usampler3D voxels;

// Per-BlockId properties (16 bytes each):
//   .x = tiles[0] | (tiles[1] << 16)
//   .y = tiles[2] | (tiles[3] << 16)
//   .z = tiles[4] | (tiles[5] << 16)
//   .w = flags: bit0=opaque, bit1=liquid, bit2=render(not air)
layout(std430, set = 0, binding = 1) readonly buffer PropsBuf {
    uvec4 props[];
};

// Output: flat uint arrays. Each vertex = 8 consecutive uints (32 bytes).
layout(std430, set = 0, binding = 2) buffer VertBuf { uint verts[]; };
layout(std430, set = 0, binding = 3) buffer IdxBuf { uint idxs[]; };
layout(std430, set = 0, binding = 4) buffer CtrBuf { uint ctr[2]; };

layout(push_constant) uniform PC {
    uint pass_mode; // 0 = opaque, 1 = transparent
} pc;

const uint FLAG_OPAQUE = 1u;
const uint FLAG_LIQUID = 2u;
const uint FLAG_RENDER = 4u;

// Face data — must match the CPU mesher's FACE_GEO + FACE_CORNERS exactly.
// Order: NegX, PosX, NegY, PosY, NegZ, PosZ
const vec3 FACE_BASE[6] = vec3[6](
    vec3(0.,0.,0.), vec3(1.,0.,0.), vec3(0.,0.,0.),
    vec3(0.,1.,0.), vec3(0.,0.,0.), vec3(0.,0.,1.)
);
const vec2 FACE_UV[24] = vec2[24](
    // NegX
    vec2(0.,1.), vec2(0.,0.), vec2(1.,0.), vec2(1.,1.),
    // PosX
    vec2(0.,1.), vec2(1.,1.), vec2(1.,0.), vec2(0.,0.),
    // NegY
    vec2(0.,0.), vec2(1.,0.), vec2(1.,1.), vec2(0.,1.),
    // PosY
    vec2(0.,0.), vec2(0.,1.), vec2(1.,1.), vec2(1.,0.),
    // NegZ
    vec2(1.,1.), vec2(0.,1.), vec2(0.,0.), vec2(1.,0.),
    // PosZ
    vec2(0.,1.), vec2(1.,1.), vec2(1.,0.), vec2(0.,0.)
);
const vec3 FACE_CORNER[24] = vec3[24](
    // NegX
    vec3(0.,0.,1.), vec3(0.,1.,1.), vec3(0.,1.,0.), vec3(0.,0.,0.),
    // PosX
    vec3(0.,0.,0.), vec3(0.,1.,0.), vec3(0.,1.,1.), vec3(0.,0.,1.),
    // NegY
    vec3(0.,0.,0.), vec3(1.,0.,0.), vec3(1.,0.,1.), vec3(0.,0.,1.),
    // PosY
    vec3(0.,0.,0.), vec3(0.,0.,1.), vec3(1.,0.,1.), vec3(1.,0.,0.),
    // NegZ
    vec3(1.,0.,0.), vec3(0.,0.,0.), vec3(0.,1.,0.), vec3(1.,1.,0.),
    // PosZ
    vec3(0.,0.,0.), vec3(1.,0.,0.), vec3(1.,1.,0.), vec3(0.,1.,0.)
);
const float FACE_SHADE[6] = float[6](0.6, 0.6, 0.4, 1.0, 0.8, 0.8);
const ivec3 FACE_NORMAL[6] = ivec3[6](
    ivec3(-1,0,0), ivec3(1,0,0), ivec3(0,-1,0),
    ivec3(0,1,0), ivec3(0,0,-1), ivec3(0,0,1)
);

uint block_tile(uint id, uint fi) {
    uvec4 p = props[id];
    uint packed = (fi < 2u) ? p.x : (fi < 4u) ? p.y : p.z;
    return (packed >> ((fi & 1u) * 16u)) & 0xFFFFu;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(coord, ivec3(16)))) return;

    uint cur_id = texelFetch(voxels, coord + ivec3(1), 0).r;
    uint cur_flags = props[cur_id].w;
    if ((cur_flags & FLAG_RENDER) == 0u) return; // air

    bool cur_opaque = (cur_flags & FLAG_OPAQUE) != 0u;
    bool cur_liquid = (cur_flags & FLAG_LIQUID) != 0u;
    bool cur_transparent = !cur_opaque;

    vec3 bpos = vec3(coord);

    for (int fi = 0; fi < 6; fi++) {
        uint neighbor_id = texelFetch(voxels, coord + ivec3(1) + FACE_NORMAL[fi], 0).r;
        uint n_flags = props[neighbor_id].w;
        bool n_opaque = (n_flags & FLAG_OPAQUE) != 0u;
        bool n_air = (n_flags & FLAG_RENDER) == 0u;

        bool emit;
        if (pc.pass_mode == 0u) {
            emit = cur_opaque && !n_opaque;
        } else {
            emit = cur_transparent && n_air;
        }
        if (!emit) continue;

        uint v_base = atomicAdd(ctr[0], 4u);
        uint i_base = atomicAdd(ctr[1], 6u);
        uint tile = block_tile(cur_id, uint(fi));
        float light = cur_liquid ? 1.5 : FACE_SHADE[fi];
        vec3 base = bpos + FACE_BASE[fi];

        uint vo = v_base * 8u;
        for (int c = 0; c < 4; c++) {
            vec3 p = base + FACE_CORNER[fi * 4 + c];
            uint o = vo + uint(c) * 8u;
            verts[o + 0] = floatBitsToUint(p.x);
            verts[o + 1] = floatBitsToUint(p.y);
            verts[o + 2] = floatBitsToUint(p.z);
            verts[o + 3] = floatBitsToUint(FACE_UV[fi * 4 + c].x);
            verts[o + 4] = floatBitsToUint(FACE_UV[fi * 4 + c].y);
            verts[o + 5] = floatBitsToUint(light);
            verts[o + 6] = tile;
            verts[o + 7] = 0u; // light_color (no colored lighting for distant chunks)
        }
        idxs[i_base + 0] = v_base;
        idxs[i_base + 1] = v_base + 1u;
        idxs[i_base + 2] = v_base + 2u;
        idxs[i_base + 3] = v_base;
        idxs[i_base + 4] = v_base + 2u;
        idxs[i_base + 5] = v_base + 3u;
    }
}
