#version 450
// GPU chunk culling for the indirect draw pipeline.
//
// One thread per candidate draw slot, ordered front-to-back for opaque and
// back-to-front for transparent by the CPU. Survivors append their command to
// a compacted per-pass list (drawn with vkCmdDrawIndexedIndirectCount), so the
// GPU only rasterises commands that passed every test. When the device lacks
// drawIndirectCount, the shader falls back to writing instanceCount=0 into the
// per-slot command buffer.
//
// The workgroup extracts the six frustum planes ONCE into shared memory. Each
// chunk's world-space AABB is tested conservatively, then against the previous
// frame's Hi-Z depth pyramid. The projected footprint is clipped to the screen
// before choosing a mip, so chunks that straddle the viewport still get a
// useful (and conservative) occlusion test.

layout(local_size_x = 64) in;

#define MAX_SLOTS 262144u

layout(set = 0, binding = 0) uniform CullUbo {
    mat4 view_proj;      // current frame: frustum culling only
    mat4 prev_view_proj; // previous frame: matches the depth pyramid
    vec4 cam_pos;        // xyz = camera position, w unused
    vec4 lod_dist;       // xyz = LOD switch distances, w = LOD count
    vec4 hiz;            // xy = pyramid mip-0 size, z = mip count, w = depth bias
};

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct Aabb {
    vec4 mn;            // xyz = min corner, w unused
    vec4 mx;            // xyz = max corner, w unused
};

// Fallback per-slot commands, indexed by the stable slot ID.
layout(std430, set = 0, binding = 1) buffer CmdBuf { DrawCmd cmds[]; };
layout(std430, set = 0, binding = 2) readonly buffer AabbBuf { Aabb aabbs[]; };
// Candidate commands, one per LOD per slot: `lod_cmds[slot * LODS + lod]`.
layout(std430, set = 0, binding = 3) readonly buffer LodCmdBuf { DrawCmd lod_cmds[]; };

// Hi-Z depth pyramid (previous frame's scene depth).
layout(set = 0, binding = 4) uniform sampler2D depth_pyramid;

// Cull counters for telemetry/debug overlays.
layout(std430, set = 0, binding = 5) buffer Stats {
    uint visible_count;
    uint frustum_culled;
    uint occlusion_culled;
    uint stats_pad;
};

// Compacted draw lists: opaque at [0, MAX_SLOTS), transparent after.
layout(std430, set = 0, binding = 6) buffer CompactBuf { DrawCmd compact_cmds[]; };
layout(std430, set = 0, binding = 7) buffer Counts { uint draw_counts[2]; };
// Per-frame slot permutation: opaque slots then transparent slots.
layout(std430, set = 0, binding = 8) readonly buffer SlotOrder { uint slot_order[]; };
// Per-slot visibility hysteresis: bit0 = visible last frame, bits1..3 = grace
// frames left before an occluded chunk is allowed to disappear.
layout(std430, set = 0, binding = 9) buffer Visibility { uint visibility[]; };
// Hierarchical cluster data: one AABB per 4x4x4-chunk group, a visibility
// bit written by the first dispatch, and a slot -> cluster index map.
layout(std430, set = 0, binding = 10) readonly buffer ClusterAabbs { Aabb cluster_aabbs[]; };
layout(std430, set = 0, binding = 11) buffer ClusterVisible { uint cluster_visible[]; };
layout(std430, set = 0, binding = 12) readonly buffer SlotCluster { uint slot_cluster[]; };

layout(push_constant) uniform PC {
    uint draw_count;      // opaque_count + transparent_count
    uint opaque_count;
    uint use_compaction;  // 0 = fallback per-slot instanceCount
    uint mode;            // 0 = chunk pass, 1 = cluster pass
    uint cluster_count;
} pc;

shared vec4 s_planes[6];

// Extract the 6 frustum planes from a column-major view-projection matrix
// (Gribb-Hartmann). GLSL `mat4` indexing yields COLUMNS, so rebuild the rows.
void extract_planes(mat4 m, out vec4 planes[6]) {
    vec4 row0 = vec4(m[0][0], m[1][0], m[2][0], m[3][0]);
    vec4 row1 = vec4(m[0][1], m[1][1], m[2][1], m[3][1]);
    vec4 row2 = vec4(m[0][2], m[1][2], m[2][2], m[3][2]);
    vec4 row3 = vec4(m[0][3], m[1][3], m[2][3], m[3][3]);
    planes[0] = row3 + row0; // left
    planes[1] = row3 - row0; // right
    planes[2] = row3 + row1; // bottom
    planes[3] = row3 - row1; // top
    planes[4] = row3 + row2; // near
    planes[5] = row3 - row2; // far
}

bool aabb_in_frustum(vec3 mn, vec3 mx) {
    vec3 center = (mn + mx) * 0.5;
    vec3 half_extent = (mx - mn) * 0.5;
    for (int i = 0; i < 6; ++i) {
        vec4 p = s_planes[i];
        float radius = dot(abs(p.xyz), half_extent);
        if (dot(p.xyz, center) + p.w < -radius) {
            return false;
        }
    }
    return true;
}

// Conservative Hi-Z test. The pyramid stores MAX depth, so a chunk is culled
// only when even its nearest corner is behind the farthest scene point under
// its (screen-clipped) footprint. Corners behind the near plane bail out to
// visible. Footprints that straddle the viewport use the on-screen rectangle
// rather than dropping the test entirely.
bool occluded_by_hiz(Aabb box) {
    if (hiz.z < 1.0) return false; // Hi-Z disabled (no pyramid)
    vec3 mn = box.mn.xyz;
    vec3 mx = box.mx.xyz;
    vec2 uv_min = vec2(1e30);
    vec2 uv_max = vec2(-1e30);
    float z_min = 1e30; // Vulkan NDC z in [0,1]: 0 = near, 1 = far
    bool clipped = false;
    for (int c = 0; c < 8; c++) {
        vec3 corner = vec3(
            (c & 1) != 0 ? mx.x : mn.x,
            (c & 2) != 0 ? mx.y : mn.y,
            (c & 4) != 0 ? mx.z : mn.z
        );
        vec4 clip = prev_view_proj * vec4(corner, 1.0);
        if (clip.w <= 0.0) return false; // crosses the near plane -> visible
        vec3 ndc = clip.xyz / clip.w;
        // Clip the projected rect to the viewport; off-screen corners still
        // contribute a conservative screen-space bound.
        if (any(lessThan(ndc.xy, vec2(-1.0))) || any(greaterThan(ndc.xy, vec2(1.0)))) {
            clipped = true;
        }
        vec2 uv = clamp(ndc.xy * 0.5 + 0.5, vec2(0.0), vec2(1.0));
        uv_min = min(uv_min, uv);
        uv_max = max(uv_max, uv);
        z_min = min(z_min, ndc.z);
    }
    // Entirely off screen: leave it visible so the current-frame frustum test
    // (and the caller's conservative ordering) decides, never the stale depth.
    if (uv_max.x <= uv_min.x || uv_max.y <= uv_min.y) return false;
    if (!clipped && (uv_max.x < 0.0 || uv_max.y < 0.0)) return false;

    vec2 size_px = (uv_max - uv_min) * hiz.xy;
    float rect_max = max(size_px.x, size_px.y);
    if (rect_max <= 1.0) return false; // sub-texel / degenerate -> visible

    int max_mip = int(max(hiz.z - 1.0, 0.0));
    int mip = int(clamp(ceil(log2(rect_max)), 0.0, float(max_mip)));
    vec2 uv = clamp((uv_min + uv_max) * 0.5, vec2(0.0), vec2(1.0));

    // At the chosen mip the clipped rect is at most one texel wide; a 2x2
    // fetch covers it. The MAX pyramid keeps the result conservative.
    ivec2 mip_size = textureSize(depth_pyramid, mip);
    ivec2 base = ivec2(floor(uv * vec2(mip_size) - vec2(0.5)));
    ivec2 hi = mip_size - ivec2(1);
    float occluder = 0.0;
    for (int oy = 0; oy <= 1; oy++) {
        for (int ox = 0; ox <= 1; ox++) {
            ivec2 t = clamp(base + ivec2(ox, oy), ivec2(0), hi);
            occluder = max(occluder, texelFetch(depth_pyramid, t, mip).x);
        }
    }
    return z_min > occluder + hiz.w;
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        extract_planes(view_proj, s_planes);
    }
    memoryBarrierShared();
    barrier();

    uint i = gl_GlobalInvocationID.x;

    // Phase 1: rejection hierarchy. One test covers up to 64 chunks.
    if (pc.mode == 1u) {
        if (i >= pc.cluster_count) return;
        Aabb box = cluster_aabbs[i];
        bool visible = aabb_in_frustum(box.mn.xyz, box.mx.xyz)
            && !occluded_by_hiz(box);
        cluster_visible[i] = visible ? 1u : 0u;
        return;
    }

    if (i >= pc.draw_count) return;

    // Opaque slots come first in the permutation (front-to-back), then the
    // transparent slots (back-to-front).
    uint pass = i < pc.opaque_count ? 0u : 1u;
    uint slot = slot_order[i];
    if (cluster_visible[slot_cluster[slot]] == 0u) {
        atomicAdd(frustum_culled, 1u);
        visibility[slot] = 0u;
        if (pc.use_compaction == 0u) cmds[slot].instanceCount = 0u;
        return;
    }
    Aabb box = aabbs[slot];

    if (!aabb_in_frustum(box.mn.xyz, box.mx.xyz)) {
        atomicAdd(frustum_culled, 1u);
        visibility[slot] = 0u;
        if (pc.use_compaction == 0u) cmds[slot].instanceCount = 0u;
        return;
    }

    // One-frame visibility hysteresis: a chunk that was visible recently is
    // kept for up to three occluded frames. Without this, camera motion makes
    // chunks pop out as the previous-frame Hi-Z reprojection drifts.
    uint vis = visibility[slot];
    bool was_visible = (vis & 1u) != 0u;
    uint grace = (vis >> 1) & 7u;
    if (occluded_by_hiz(box)) {
        if (!was_visible || grace == 0u) {
            atomicAdd(occlusion_culled, 1u);
            visibility[slot] = 0u;
            if (pc.use_compaction == 0u) cmds[slot].instanceCount = 0u;
            return;
        }
        grace -= 1u;
    } else {
        grace = 3u;
    }

    // Distance-based LOD. `lod_dist.w` is the LOD count; with one level this
    // degenerates to LOD 0.
    vec3 center = (box.mn.xyz + box.mx.xyz) * 0.5;
    float dist = distance(center, cam_pos.xyz);
    uint lod_count = uint(lod_dist.w);
    uint lod = 0u;
    for (uint l = 0u; l + 1u < lod_count; l++) {
        if (dist >= lod_dist[l]) {
            lod = l + 1u;
        }
    }

    // Hysteresis around the LOD threshold. Without it a chunk straddling the
    // boundary can alternate level on tiny camera movements, which reads as
    // shimmering geometry. The previous level is stored in visibility bits
    // 4..5 (the visibility/grace bits are repacked below).
    uint prev_lod = (vis >> 4) & 3u;
    if (prev_lod >= lod_count) prev_lod = 0u;
    if (lod_count > 0u && lod != prev_lod) {
        if (lod > prev_lod && dist < lod_dist[prev_lod] + 6.0) {
            lod = prev_lod;
        } else if (lod < prev_lod && dist > lod_dist[lod] - 6.0) {
            lod = prev_lod;
        }
    }
    visibility[slot] = 1u | (grace << 1) | (min(lod, 3u) << 4);

    DrawCmd out_cmd = lod_cmds[slot * max(lod_count, 1u) + lod];
    out_cmd.instanceCount = 1u;

    atomicAdd(visible_count, 1u);
    if (pc.use_compaction != 0u) {
        uint n = atomicAdd(draw_counts[pass], 1u);
        uint base = pass == 0u ? 0u : MAX_SLOTS;
        compact_cmds[base + n] = out_cmd;
    } else {
        cmds[slot] = out_cmd;
    }
}
