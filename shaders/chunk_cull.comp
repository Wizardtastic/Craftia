#version 450
// Phase 1 — GPU frustum culling for the indirect chunk draw pipeline.
//
// One thread per candidate draw slot. Reads the chunk's world-space AABB,
// tests it against the 6 frustum planes derived from the camera view-projection,
// and writes `instanceCount` into the indirect command buffer:
//   1 = visible (draw me), 0 = culled (skip — becomes a no-op draw).
// The command's geometry fields (indexCount, firstIndex, vertexOffset,
// firstInstance) are pre-filled by the CPU and left untouched by this shader.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform CullUbo {
    mat4 view_proj;     // world -> clip (column-major, same as the vertex shader)
    vec4 cam_pos;       // xyz = camera position, w unused
    vec4 lod_dist;      // xyz = LOD switch distances, w = LOD count
    vec4 hiz;           // xy = pyramid mip-0 size, z = mip count, w = depth bias
};

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

struct Aabb {
    vec4 mn;            // xyz = min corner, w unused
    vec4 mx;            // xyz = max corner, w unused
};

layout(std430, set = 0, binding = 1) buffer CmdBuf  { DrawCmd cmds[]; };
layout(std430, set = 0, binding = 2) readonly buffer AabbBuf { Aabb aabbs[]; };

// Candidate draw commands, one per LOD per chunk slot: `lod_cmds[i * LODS + l]`.
// The geometry fields (indexCount, firstIndex, vertexOffset) are prefilled by
// the CPU; `firstInstance` is the chunk's slot index (into the origins SSBO).
layout(std430, set = 0, binding = 3) readonly buffer LodCmdBuf { DrawCmd lod_cmds[]; };

// Hi-Z depth pyramid (previous frame's scene depth). Sampled for occlusion.
layout(set = 0, binding = 4) uniform sampler2D depth_pyramid;

layout(push_constant) uniform PC {
    uint draw_count;
} pc;

// Extract the 6 frustum planes from a column-major view-projection matrix
// (Gribb-Hartmann). Each plane (a,b,c,d) satisfies a*x+b*y+c*z+d >= 0 inside.
// Because GLSL `mat4` indexing yields COLUMNS, we rebuild the ROWS first.
void extract_planes(mat4 m, out vec4 planes[6]) {
    vec4 row0 = vec4(m[0][0], m[1][0], m[2][0], m[3][0]);
    vec4 row1 = vec4(m[0][1], m[1][1], m[2][1], m[3][1]);
    vec4 row2 = vec4(m[0][2], m[1][2], m[2][2], m[3][2]);
    vec4 row3 = vec4(m[0][3], m[1][3], m[2][3], m[3][3]);
    planes[0] = row3 + row0; // left
    planes[1] = row3 - row0; // right
    planes[2] = row3 + row1; // bottom
    planes[3] = row3 - row1; // top
    planes[4] = row3 + row2; // near
    planes[5] = row3 - row2; // far
}

// Hi-Z occlusion test against the previous frame's depth pyramid.
bool occluded_by_hiz(Aabb box) {
    if (hiz.z < 1.0) return false; // Hi-Z disabled (no pyramid)
    vec3 mn = box.mn.xyz;
    vec3 mx = box.mx.xyz;
    vec2 s_min = vec2(1e30);
    vec2 s_max = vec2(-1e30);
    float z_max = -1e30; // Vulkan NDC z in [0,1]: 0 = near, 1 = far
    for (int c = 0; c < 8; c++) {
        vec3 corner = vec3(
            (c & 1) != 0 ? mx.x : mn.x,
            (c & 2) != 0 ? mx.y : mn.y,
            (c & 4) != 0 ? mx.z : mn.z
        );
        vec4 clip = view_proj * vec4(corner, 1.0);
        if (clip.w <= 0.0) return false; // crosses the near plane -> visible
        vec3 ndc = clip.xyz / clip.w;
        s_min = min(s_min, ndc.xy);
        s_max = max(s_max, ndc.xy);
        z_max = max(z_max, ndc.z);
    }
    vec2 uv_min = clamp(s_min * 0.5 + 0.5, 0.0, 1.0);
    vec2 uv_max = clamp(s_max * 0.5 + 0.5, 0.0, 1.0);
    // Rect size in pyramid mip-0 texels (mip 0 is half framebuffer res).
    vec2 size_px = (uv_max - uv_min) * hiz.xy;
    float rect_max = max(size_px.x, size_px.y);
    if (rect_max <= 1.0) return false; // sub-texel / degenerate -> visible
    float mip = clamp(ceil(log2(rect_max)), 0.0, max(hiz.z - 1.0, 0.0));
    float occluder = textureLod(depth_pyramid, (uv_min + uv_max) * 0.5, mip).x;
    return z_max > occluder + hiz.w;
}

// Conservative AABB-vs-frustum test (the "p-vertex" test). A box is culled only
// when its corner most along a plane's normal is still outside that plane, so a
// partially-visible box is never discarded.
bool aabb_in_frustum(vec4 planes[6], vec3 mn, vec3 mx) {
    for (int i = 0; i < 6; ++i) {
        vec4 p = planes[i];
        vec3 p_vertex = vec3(
            (p.x >= 0.0) ? mx.x : mn.x,
            (p.y >= 0.0) ? mx.y : mn.y,
            (p.z >= 0.0) ? mx.z : mn.z
        );
        if (dot(p.xyz, p_vertex) + p.w < 0.0) {
            return false;
        }
    }
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.draw_count) return;

    vec4 planes[6];
    extract_planes(view_proj, planes);

    Aabb box = aabbs[i];
    bool visible = aabb_in_frustum(planes, box.mn.xyz, box.mx.xyz);
    if (!visible) {
        cmds[i].instanceCount = 0u;
        return;
    }

    // Hi-Z occlusion test: cull chunks fully hidden behind the previous
    // frame's depth. Conservative-ish: a chunk is culled only when its
    // FARTHEST corner is behind the NEAREST occluder sampled from the pyramid
    // (plus a bias), so a chunk that even partially pokes out is kept.
    if (occluded_by_hiz(box)) {
        cmds[i].instanceCount = 0u;
        return;
    }

    // Distance-based LOD: pick the coarsest level whose switch distance the
    // chunk exceeds. `lod_dist.w` is the LOD count; with a single level this
    // degenerates to LOD 0.
    vec3 center = (box.mn.xyz + box.mx.xyz) * 0.5;
    float dist = distance(center, cam_pos.xyz);
    uint lod_count = uint(lod_dist.w);
    uint lod = 0u;
    for (uint l = 0u; l + 1u < lod_count; l++) {
        if (dist >= lod_dist[l]) {
            lod = l + 1u;
        }
    }

    cmds[i] = lod_cmds[i * lod_count + lod];
    cmds[i].instanceCount = 1u;
}
